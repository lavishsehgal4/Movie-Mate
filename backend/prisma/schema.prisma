generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum TheatreRole {
  OWNER
  MANAGER
  STAFF
}

model users {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String?   // optional
  email       String    @unique
  phoneNumber String?    @unique

  role        UserRole @default(USER)  

  dateOfBirth DateTime?
  imageUrl    String?   // optional

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // relation
  auths       Auth[]
  theatreUsers TheatreUser[] 
  bookings Booking[]
}

model Auth {
  id           Int      @id @default(autoincrement())
  userId       Int
  provider     String   // local, google, github...
  providerKey  String?  // conditional
  password     String?  // conditional

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relation with cascade delete
  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  // unique constraint
  @@unique([userId, provider])

  // map to lowercase table name
  @@map("auth")
}

model TheatreUser {
  user_id    Int
  theatre_id Int
  role       TheatreRole

  user     users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  theatre  Theatre @relation(fields: [theatre_id], references: [id], onDelete: Cascade)

  @@id([user_id, theatre_id])
  @@index([user_id])
}

model Movie {
  id                Int      @id @default(autoincrement())

  tmdb_id           Int      @unique
  title             String
  search_title      String  // ✅ ADD THIS
  original_title    String?
  overview          String?

  poster_path       String
  backdrop_path     String?

  release_date      DateTime
  contract_end      DateTime?   // ✅ ADD THIS
  runtime           Int?

  popularity        Float
  adult             Boolean

  certification     String?

  vote_average      Float
  vote_count        Int

  original_language String

  genres            Json?
  cast              Json?

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  shows Show[]
   // 🔥 INDEXES
  @@index([popularity])
  @@index([release_date])
  @@index([contract_end])
  @@index([original_language])
  @@index([title])
}

model Theatre {
  id             Int      @id @default(autoincrement())

  theatre_name   String
  chain_name     String
  chain_logo     String

  state          String
  city           String
  address        String

  longitude      Decimal? @db.Decimal(9,6)
  latitude       Decimal? @db.Decimal(9,6)

  contact_no     String
  email          String

  total_screens  Int?

  is_active      Boolean

  rating         Decimal? @db.Decimal(3,1)

  google_map_url String?

  opening_time   DateTime
  closing_time   DateTime

  pincode        Int?
  landmark       String?

  is_verified    Boolean  @default(false)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  deleted_at     DateTime?

  // Relations
  theatreFacilities TheatreFacility[]
  screens Screen[]
  shows   Show[]
  theatreUsers   TheatreUser[]
  
  @@index([city])
  @@index([chain_name, city])
  @@index([longitude, latitude])
  @@index([state])
}

model Facility {
  id            Int      @id @default(autoincrement())

  facility_name String   @unique
  facility_logo String?

  theatreFacilities TheatreFacility[]
}

model TheatreFacility {
  theatre_id  Int
  facility_id Int

  theatre  Theatre @relation(fields: [theatre_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facility Facility @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // ✅ Composite Primary Key
  @@id([theatre_id, facility_id])

  // ⚠️ IMPORTANT:
  // Composite index works LEFT → RIGHT
  // Means:
  // ✔ WHERE theatre_id = ?         (fast)
  // ✔ WHERE theatre_id = ? AND facility_id = ? (fast)
  // ❌ WHERE facility_id = ?       (NOT optimized)

  // ✅ So we add separate index for facility_id
  @@index([facility_id])
}

// =========================
// SCREENS
// =========================
model Screen {
  id          Int     @id @default(autoincrement())
  theatre_id  Int
  screen_name String
  seat_layout   Json?     // Stores the grid layout selected by user

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  theatre Theatre @relation(fields: [theatre_id], references: [id], onDelete: Cascade)

  shows Show[]
  seats  Seat[]
  @@index([theatre_id])
}

// =========================
// SHOW STATUS ENUM
// =========================
enum ShowStatus {
  scheduled
  cancelled
}

// =========================
// SHOWS
// =========================
model Show {
  id         Int      @id @default(autoincrement())

  movie_id   Int
  screen_id  Int
  theatre_id Int
  city String

  start_time DateTime
  end_time   DateTime

  language   String
  format     String
  base_price Decimal @db.Decimal(10,2)

  show_status ShowStatus @default(scheduled)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  movie   Movie   @relation(fields: [movie_id], references: [id], onDelete: Restrict)
  screen  Screen  @relation(fields: [screen_id], references: [id], onDelete: Cascade)
  theatre Theatre @relation(fields: [theatre_id], references: [id], onDelete: Cascade)

  showSeats  ShowSeat[]
  bookings Booking[]

  // Indexes
  @@index([movie_id])
  @@index([screen_id])
  @@index([theatre_id])
  @@index([screen_id, start_time])
  @@index([city, start_time, movie_id])
  @@index([start_time])

  // ⚠️ NOTE:
  // Prisma does NOT support exclusion constraints (no overlap)
  // You must enforce overlapping logic in backend/service layer
}

// =========================
// SEAT
// =========================
model Seat {
  id                Int      @id @default(autoincrement())
  screen_id         Int
  row_label         String
  seat_number       Int
  price_multiplier  Decimal  @db.Decimal(3,2) @default(1.00)
  seat_type         String
  is_active         Boolean  @default(true)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  screen            Screen   @relation(fields: [screen_id], references: [id], onDelete: Cascade)
  showSeats         ShowSeat[]

  @@unique([screen_id, row_label, seat_number])
  @@index([screen_id])
  @@index([screen_id, is_active])
}

// =========================
// SHOWSEAT
// =========================
model ShowSeat {
  id                Int        @id @default(autoincrement())
  show_id           Int
  seat_id           Int
  status            SeatStatus @default(AVAILABLE)
  locked_by         Int?
  lock_until        DateTime?

  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  show              Show       @relation(fields: [show_id], references: [id], onDelete: Cascade)
  seat              Seat       @relation(fields: [seat_id], references: [id], onDelete: Cascade)
  bookingSeat       BookingSeat?

  @@unique([show_id, seat_id])
  @@index([show_id])
  @@index([show_id, status])
  @@index([locked_by])
  @@index([lock_until])
}

// =========================
// BOOKING
// =========================
model Booking {
  id                Int            @id @default(autoincrement())
  user_id           Int
  show_id           Int
  total_amount      Decimal        @db.Decimal(10, 2)
  status            BookingStatus  @default(PENDING)
  payment_status    PaymentStatus  @default(PENDING)
  payment_id        String?

  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  user              users          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  show              Show           @relation(fields: [show_id], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]

  @@index([user_id])
  @@index([show_id])
  @@index([payment_id])
}

// =========================
// BOOKINGSEAT (Junction)
// =========================
model BookingSeat {
  booking_id   Int
  showSeat_id  Int

  booking  Booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  showSeat ShowSeat @relation(fields: [showSeat_id], references: [id], onDelete: Restrict)

  // composite primary key
  @@id([booking_id, showSeat_id])

  // indexes
  @@index([booking_id])

  // one show seat -> one booking only
  @@unique([showSeat_id])
}

// =========================
// ENUMS
// =========================
enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}



// state and city table yet to be modified 


model State {
  id          Int      @id @default(autoincrement())

  name        String
  code        String   @unique

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  regions     Region[]

  @@unique([name])
}



model Region {
  id                       Int      @id @default(autoincrement())

  name                     String

  code                     String   @unique

  slug                     String   @unique

  aliases                  String[]

  latitude                 Decimal  @db.Decimal(9,6)
  longitude                Decimal  @db.Decimal(9,6)

  allow_sales              Boolean  @default(true)

  geohash                  String?

  priority                 Int      @default(0)

  honour_subregion_slug    Boolean  @default(false)

  state_id                 Int

  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  // Relations
  state                    State @relation(fields: [state_id], references: [id], onDelete: Cascade)

  subregions               SubRegion[]

  

  // Indexes
  @@index([state_id])

  @@index([slug])

  @@index([priority])

  @@index([latitude, longitude])

  @@unique([state_id, name])
}



model SubRegion {
  id              Int      @id @default(autoincrement())

  name            String

  code            String   @unique

  slug            String

  latitude        Decimal  @db.Decimal(9,6)
  longitude       Decimal  @db.Decimal(9,6)

  allow_sales     Boolean  @default(true)

  geohash         String?

  priority        Int      @default(0)

  region_id       Int

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  region          Region @relation(fields: [region_id], references: [id], onDelete: Cascade)

  

  // Indexes
  @@index([region_id])

  @@index([slug])

  @@index([priority])

  @@index([latitude, longitude])

  @@unique([region_id, name])
}